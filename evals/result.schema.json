{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering Agent Skills evaluation result",
  "type": "object",
  "required": ["schema_version", "skill_name", "run", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "skill_name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "run": {
      "type": "object",
      "required": ["mode", "runtime", "model", "input_revision", "skill_instruction_sha256", "recorded_on", "run_count", "baseline_definition", "variance", "limitations"],
      "properties": {
        "mode": {"enum": ["with_skill", "baseline"]},
        "runtime": {"type": "string"},
        "model": {"type": "string"},
        "input_revision": {"type": "string"},
        "skill_instruction_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "recorded_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "run_count": {"type": "integer", "minimum": 1},
        "baseline_definition": {"type": "string", "minLength": 1},
        "variance": {"enum": ["not_applicable_single_run", "reported_separately"]},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "started_at": {"type": "string"}
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["eval_id", "input_sha256", "output_reference", "output_sha256", "writes_attempted", "assertions"],
        "properties": {
          "eval_id": {"type": "integer", "minimum": 1},
          "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "output_reference": {"type": "string"},
          "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "writes_attempted": {"type": "boolean"},
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "status", "evidence"],
              "properties": {
                "id": {"type": "string"},
                "status": {"enum": ["passed", "failed", "not_applicable"]},
                "evidence": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
